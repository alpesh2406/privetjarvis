<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/hud_bg" />

    <item android:gravity="center" android:width="340dp" android:height="340dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#1500E5FF" />
        </shape>
    </item>

    <item android:gravity="center" android:width="280dp" android:height="280dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#2000E5FF" />
        </shape>
    </item>

    <item android:gravity="center" android:width="220dp" android:height="220dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#2A00E5FF" />
        </shape>
    </item>

    <item android:gravity="center" android:width="400dp" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#1000E5FF" />
        </shape>
    </item>

    <item android:gravity="center" android:width="1dp" android:height="400dp">
        <shape android:shape="rectangle">
            <solid android:color="#1000E5FF" />
        </shape>
    </item>
</layer-list>
